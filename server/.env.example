PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Rate limits (max requests per IP per 15 minutes). Optional.
# Defaults: production -> auth 10, api 300; otherwise -> auth 1000, api 10000
# AUTH_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_MAX=300

# Fraud detection: max write requests (POST/PUT/PATCH/DELETE) per user per minute before
# a FraudLog is created, +30 fraudScore and a 429 is returned. Optional.
# Defaults: production -> 60; otherwise -> 600
# FRAUD_WRITE_LIMIT=60

# MongoDB Atlas - https://cloud.mongodb.com (free)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aluminet?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=aluminet_jwt_secret_2025_change_this
JWT_REFRESH_SECRET=aluminet_refresh_secret_2025_change_this
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Groq AI - FREE at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Email — required for password reset & notifications (Gmail App Password)
# https://myaccount.google.com/apppasswords (2FA must be on)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=AlumiNet <your_email@gmail.com>
